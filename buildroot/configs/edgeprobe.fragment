# Merged on top of Buildroot's stock qemu_* defconfigs by
# scripts/buildroot-image.sh (support/kconfig/merge_config.sh).

# edgeprobe is a glibc binary
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# Reproducible image builds (fixed timestamps, no build paths)
BR2_REPRODUCIBLE=y

# Our package + SysV init (the stock qemu configs use BusyBox init)
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_EDGEPROBE=y

BR2_TARGET_GENERIC_HOSTNAME="edge-qemu"
BR2_TARGET_GENERIC_ISSUE="edgeprobe test image"
